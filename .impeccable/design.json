    {
      "name": "Reply choices",
      "kind": "input",
      "refersTo": "reply-option",
      "description": "Native radio choices with the implemented checked treatment. No extra hover or disabled style is authored.",
      "html": "<fieldset class=\"ds-replies\"><legend>Where should we reply?</legend><div class=\"ds-options\"><label><input type=\"radio\" name=\"ds-reply\" value=\"Email\" checked><span>Email</span></label><label><input type=\"radio\" name=\"ds-reply\" value=\"Telegram\"><span>Telegram</span></label><label><input type=\"radio\" name=\"ds-reply\" value=\"WhatsApp\"><span>WhatsApp</span></label></div></fieldset>",
      "css": ".ds-replies{border:0;padding:0;margin:0;min-width:0;font-family:'Deviny Sans',Arial,sans-serif;color:var(--text,#202822)}.ds-replies legend{display:block;font-size:.875rem;font-weight:500;line-height:1.6;margin-bottom:9px}.ds-options{display:flex;flex-wrap:wrap;gap:10px}.ds-options label{display:flex;align-items:center;gap:8px;border:1px solid #969f90;border-radius:8px;padding:10px 12px;cursor:pointer;font-size:.875rem;line-height:1.6;min-height:44px}.ds-options label:has(:checked){color:var(--text,#202822);border-color:var(--text,#202822);background:#f8f9f4}.ds-options input{accent-color:#3e4b3b;width:16px;height:16px;margin:0}.ds-options input:focus-visible{outline:3px solid #89651d;outline-offset:5px;}@media(max-width:620px){.ds-options{gap:7px}.ds-options label{padding:9px;font-size:.8125rem}}"
