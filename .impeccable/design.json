      "kind": "card",
      "refersTo": "form-panel",
      "description": "Abbreviated source contact panel, with a non-submitting button for preview. The live form has additional fields and feedback.",
      "html": "<section class=\"ds-panel\"><h2>Send a message</h2><div class=\"ds-form\"><div class=\"ds-field\"><label for=\"ds-panel-name\">Your name</label><input class=\"ds-input\" id=\"ds-panel-name\" placeholder=\"How should we address you?\" autocomplete=\"name\"></div><button class=\"ds-button ds-submit\" type=\"button\"><span>Send message</span><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div></section>",
      "css": ".ds-field{min-width:0;font-family:'Deviny Sans',Arial,sans-serif;color:var(--text,#202822)}.ds-field label{display:block;font-size:.875rem;font-weight:500;line-height:1.6;margin-bottom:9px}.ds-input{width:100%;border:1px solid #969f90;border-radius:8px;background:#fbfcf8;color:var(--text,#202822);padding:12px 14px;min-height:48px;font-family:'Deviny Sans',Arial,sans-serif;font-size:1rem;line-height:1.5}.ds-input::placeholder{color:#677061;opacity:1}.ds-input:focus-visible{outline:3px solid #89651d;outline-offset:5px;}.ds-input[aria-invalid=true]{border-color:#a03535}.ds-field-error{color:#9b2929;font-size:.875rem;line-height:1.5;margin:7px 0 0}.ds-field-error:empty{display:none}.ds-button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;min-height:54px;padding:15px 23px;border:1px solid transparent;border-radius:10px;background:var(--text,#202822);color:#fff;font-family:'Deviny Sans',Arial,sans-serif;font-size:.9375rem;font-weight:500;text-decoration:none;line-height:1.4;max-width:100%;cursor:pointer;transition:background .2s,box-shadow .2s}.ds-button:hover{background:#3e4b3b;box-shadow:0 6px 16px #20282219}.ds-button svg{width:21px;height:24px;flex:none;transition:transform .2s}.ds-button:hover svg{transform:translateX(3px)}.ds-button:focus-visible{outline:3px solid #89651d;outline-offset:5px;}.ds-button:disabled{cursor:wait;background:#66735f;box-shadow:none}@media(prefers-reduced-motion:reduce){.ds-button,.ds-button svg{transition:none}}.ds-panel{border-radius:16px;background:var(--surface,#eaece5);padding:36px;font-family:'Deviny Sans',Arial,sans-serif;color:var(--text,#202822)}.ds-panel h2{margin:0 0 30px;font-size:1.6rem;font-weight:500;line-height:1.08;letter-spacing:-.035em;text-wrap:balance}.ds-form{display:grid;gap:22px}.ds-submit{width:100%;justify-content:space-between}@media(max-width:1150px){.ds-panel{padding:28px}}@media(max-width:620px){.ds-panel{padding:26px 20px}.ds-panel h2{font-size:1.45rem}.ds-submit{font-size:.9375rem;gap:12px;padding-inline:16px}}"
    },
    {
      "name": "Homepage primary action",
      "kind": "button",
      "refersTo": "home-button-primary",
      "description": "Homepage hero and closing action: 12px radius, 60px minimum height, gold circular arrow; 56px high on small phones.",
      "html": "<a class=\"ds-home-button\" href=\"/#get-started\">Download the app<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
